# Syncraft Environment Configuration Example
# Copy this file to .env and adjust variables for your local setup.

# Collaboration Server
PORT=1234
HOST=0.0.0.0
NODE_ENV=development

# Database Configuration (PostgreSQL)
# Format: postgres://<user>:<password>@<host>:<port>/<database>
# If using passwordless local role (e.g., trust authentication on localhost):
# DATABASE_URL=postgres://syncraft_app@127.0.0.1:5432/syncraft_dev
# If using password authentication:
DATABASE_URL=postgres://syncraft_app:your_secure_password@127.0.0.1:5432/syncraft_dev

# Test Database Configuration
TEST_DATABASE_URL=postgres://syncraft_app@127.0.0.1:5432/syncraft_test

# Client Configuration
VITE_SERVER_URL=ws://127.0.0.1:1234
